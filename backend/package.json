{
  "name": "bethaniel-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "betty": "./betty"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "start": "node --max-old-space-size=8192 dist/index.js",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsx -r ./preload.cjs src/index.ts",
    "cli": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsx -r ./preload.cjs src/cli.ts",
    "bench:modes": "tsx scripts/bench-modes.ts",
    "bench:chapters": "tsx scripts/bench-chapters.ts",
    "install:betty": "npm link",
    "uninstall:betty": "npm unlink -g bethaniel-backend"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "express": "^4.21.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "nspell": "^2.1.5",
    "retext": "^9.0.0",
    "retext-contractions": "^6.0.0",
    "retext-english": "^5.0.0",
    "retext-indefinite-article": "^5.0.0",
    "retext-quotes": "^6.0.2",
    "retext-redundant-acronyms": "^5.0.0",
    "retext-repeated-words": "^5.0.0",
    "retext-sentence-spacing": "^6.0.0",
    "retext-stringify": "^4.0.0",
    "socket.io": "^4.8.0",
    "turndown": "^7.2.4",
    "unified": "^11.0.5",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/diff": "^7.0.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.0",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0"
  }
}
